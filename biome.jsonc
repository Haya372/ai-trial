{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  // フロントエンド各パッケージ（apps/web・apps/e2e・packages/ui）で共通の設定。
  // 各パッケージの biome.jsonc は "extends": "//" でこの設定を継承し、差分だけを書く。
  // ルートでは formatter を無効にし、各パッケージ外のファイルは整形しない（各パッケージで有効化する）。
  // リンターは oxlint が担当するため無効のまま。
  // vcs はルートの設定だけが有効で、各パッケージの biome.jsonc に書いても .gitignore は読まれない。
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "enabled": false
  },
  "formatter": {
    "enabled": false,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
