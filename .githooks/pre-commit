#!/bin/sh
set -e

STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
    exit 0
fi

if ! command -v goimports > /dev/null 2>&1; then
    echo "ERROR: goimports not found. Install: go install golang.org/x/tools/cmd/goimports@latest" >&2
    exit 1
fi

for f in $STAGED_GO_FILES; do
    # Abort if the working tree has unstaged changes on this file to avoid
    # accidentally pulling those changes into the commit via git add.
    if ! git diff --quiet -- "$f"; then
        echo "ERROR: $f has unstaged changes. Stage or stash them before committing." >&2
        exit 1
    fi
    gofmt -w "$f"
    goimports -w "$f"
    git add "$f"
done
