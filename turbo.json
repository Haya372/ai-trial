{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {},
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/biome.jsonc",
        "$TURBO_ROOT$/.oxlintrc.jsonc"
      ]
    },
    "format": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/biome.jsonc",
        "$TURBO_ROOT$/.oxlintrc.jsonc"
      ]
    },
    "bundle": {
      "outputs": ["dist/**"]
    }
  }
}
