{
  "name": "ai-trial",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:schema": "pnpm --filter @ai-trial/schema dev",
    "lint:schema": "pnpm --filter @ai-trial/schema lint",
    "lint": "turbo lint",
    "format": "turbo format",
    "build": "turbo build",
    "generate": "pnpm generate:frontend && pnpm generate:sqlc && pnpm generate:backend && pnpm generate:web",
    "generate:backend": "make -C apps/backend generate",
    "generate:sqlc": "make -C apps/backend sqlc-generate",
    "generate:frontend": "pnpm --filter @ai-trial/schema generate:frontend",
    "generate:web": "pnpm --filter web generate:routes"
  },
  "devDependencies": {
    "lefthook": "2.2.2",
    "npm-run-all2": "9.0.4",
    "turbo": "2.11.10"
  }
}
