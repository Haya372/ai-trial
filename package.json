{
  "name": "ai-trial",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:schema": "pnpm --filter @ai-trial/schema dev",
    "lint:schema": "pnpm --filter @ai-trial/schema lint",
    "lint": "turbo lint",
    "format": "turbo format",
    "build": "turbo build",
    "generate": "turbo generate:backend && pnpm generate:frontend",
    "generate:backend": "make -C apps/backend oapi-codegen-generate",
    "generate:frontend": "pnpm --filter @ai-trial/schema generate:frontend"
  },
  "devDependencies": {
    "lefthook": "2.1.12",
    "npm-run-all2": "9.0.3",
    "turbo": "2.10.12"
  }
}
