{
  "$schema": "./apps/web/node_modules/oxlint/configuration_schema.json",
  // 継承する側で plugins を省略すると oxlint のデフォルト（unicorn 等）が追加されるため、
  // 追加の plugin がなくても "plugins": [] を明示する。plugins はこの設定と和集合でマージされる。
  "plugins": ["typescript", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error"
  }
}
