{
  "root": false,
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "extends": "//",
  "files": {
    "includes": ["**", "!!**/dist/**", "!!storybook-static/**"]
  },
  "formatter": {
    "enabled": true
  },
  "css": {
    "parser": {
      "cssModules": false,
      "allowWrongLineComments": false,
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": false
    }
  }
}
