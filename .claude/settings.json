{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "dangerouslyDisableSandbox": false,
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git stash *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh repo view *)",
      "Bash(gh run *)",
      "Bash(gh workflow *)",
      "Bash(mise list *)",
      "Bash(mise which *)",
      "Bash(mise version)",
      "Bash(actionlint *)",
      "Bash(shellcheck *)",
      "Bash(gitleaks *)",
      "Bash(zizmor *)",
      "Bash(pinact *)"
    ],
    "deny": [
      "Bash(gh config *)",
      "Bash(gh auth *)",
      "Bash(gh secret *)",
      "Bash(gh project *)",
      "Bash(gh release *)",
      "Bash(gh repo *)",
      "Bash(gh ssh-key *)",
      "Bash(gh codespace *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ]
  }
}
