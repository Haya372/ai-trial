{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainerSpec.schema.json",
  "name": "ai-trial",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.yml"],
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "forwardPorts": [8080, 5173, 5432],
  "portsAttributes": {
    "8080": { "label": "Backend API" },
    "5173": { "label": "Frontend (Vite)" },
    "5432": { "label": "PostgreSQL" }
  },
  "postCreateCommand": "mise install && mise exec -- pnpm install",
  "remoteEnv": {
    "DB_HOST": "postgres"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "biomejs.biome",
        "ms-vscode.vscode-typescript-next",
        "DavidAnson.vscode-markdownlint"
      ]
    }
  }
}
